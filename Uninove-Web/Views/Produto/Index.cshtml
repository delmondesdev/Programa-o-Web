@{
    ViewData["Title"] = "Catálogo de Produtos";
    var nomes = ViewBag.Nomes as List<string>;
    var precos = ViewBag.Precos as List<double>;
}

<h2>Catálogo de Produtos</h2>

<table border="1" cellpadding="8" cellspacing="0">
    <thead>
        <tr>
            <th>#</th>
            <th>Nome</th>
            <th>Preço</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < nomes.Count; i++)
        {
            if (precos[i] < 100)
            {
                <tr style="background-color: #d4edda;">
                    <td>@(i + 1)</td>
                    <td>@nomes[i]</td>
                    <td>R$ @precos[i].ToString("F2")</td>
                </tr>
            }
            else
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td>@nomes[i]</td>
                    <td>R$ @precos[i].ToString("F2")</td>
                </tr>
            }
        }
    </tbody>
</table>

<p><strong>Total: @nomes.Count produtos</strong></p>
